# Copy to .env and fill in when going live. Everything works without it (demo mode).
DEMO_MODE=1

# Pretend "today" is a different date (YYYY-MM-DD). Used for testing/demos.
RENT_PING_TODAY=

# Random string for cookies — set a real one in production.
SECRET_KEY=change-me

# Real SMS (set DEMO_MODE=0 too)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Real billing (set DEMO_MODE=0 too)
STRIPE_SECRET_KEY=

# Optional: require ?token=... on /internal/run-reminders
INTERNAL_CRON_TOKEN=
